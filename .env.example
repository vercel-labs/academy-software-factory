FACTORY_REPO=your-github-name/signalworks-software-factory
FACTORY_LABEL=factory
FACTORY_BRANCH_PREFIX=factory/
FACTORY_SETUP_COMMAND=pnpm install --frozen-lockfile
GITHUB_CONNECTOR=github/signalworks-factory
ROUTER_MODEL=openai/gpt-5.4-mini
FACTORY_MODEL=openai/gpt-5.4-mini
# BUILDER_MODEL and VERIFIER_MODEL can override individual stations.
