  "dependencies": {
    "@github-tools/eve-extension": "0.3.2",
    "@vercel/connect": "0.8.0",
    "ai": "7.0.63",
    "eve": "0.37.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.19.0"
}
