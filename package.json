{
  "name": "signalworks-software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "A risk-routed software factory built with eve and AI SDK.",
  "type": "module",
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "eval": "eve eval",
    "test": "vitest run",
